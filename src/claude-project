#!/usr/bin/env bash
# claude-project: Launch Claude Code with a specific project context
#
# Usage: claude-project <project-name> [claude-options]
#
# This wrapper sets the PROJECT environment variable and launches Claude Code.
# Pair it with bootstrap-session.sh (via Claude Desktop SessionStart hooks) to
# stream context automatically before the first prompt is sent.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECTS_DIR="${PROJECTS_DIR:-${SCRIPT_DIR}/projects}"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"

if [[ $# -eq 0 ]]; then
  echo "Usage: claude-project <project-name> [claude-options]" >&2
  echo "" >&2
  echo "Available projects:" >&2
  if [[ -d "${PROJECTS_DIR}" ]]; then
    ls -1 "${PROJECTS_DIR}" 2>/dev/null | sed 's/^/  /' >&2 || echo "  (none found)" >&2
  else
    echo "  (projects directory not found: ${PROJECTS_DIR})" >&2
  fi
  exit 1
fi

PROJECT_NAME="$1"
shift

# Export PROJECT for bootstrap/session hooks
export PROJECT="${PROJECT_NAME}"

# Launch Claude CLI and seed the first message with the project name; pass through extra args.
exec env PROJECT="${PROJECT_NAME}" "${CLAUDE_BIN}" "${PROJECT_NAME}" "$@"
